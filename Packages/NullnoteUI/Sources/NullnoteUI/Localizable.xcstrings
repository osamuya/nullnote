    "ドラッグか二本指で移動。ピンチ、⌘＋ホイールで拡大" : {
      "comment" : "拡大窓の下に出す操作の案内",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen oder wischen zum Verschieben. Pinch oder ⌘-Scrollen zum Zoomen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag or swipe with two fingers to pan. Pinch or ⌘-scroll to zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisser ou balayer pour déplacer. Pincer ou ⌘-défiler pour zoomer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグか二本指で移動。ピンチ、⌘＋ホイールで拡大"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하거나 두 손가락으로 쓸어 이동. 핀치 또는 ⌘-스크롤로 확대/축소."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移或双指轻扫以移动。捏合或 ⌘+滚动以缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移或雙指滑動以移動。雙指開合或 ⌘+捲動以縮放。"
          }
        }
      }
    },
