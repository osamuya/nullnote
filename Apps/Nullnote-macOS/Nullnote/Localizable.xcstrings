    "見出しに合わせてファイル名を付け直すために、「%@」への書き込みを許可してください。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube das Schreiben in „%@“, damit die Datei passend zur Überschrift umbenannt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To rename the file to match its heading, allow writing to “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour renommer le fichier d’après son titre, autorisez l’écriture dans « %@ »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見出しに合わせてファイル名を付け直すために、「%@」への書き込みを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목에 맞춰 파일 이름을 변경하려면 ‘%@’에 쓰기를 허용하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要按标题重命名文件，请允许写入“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要依標題重新命名檔案，請允許寫入「%@」。"
          }
        }
      }
    },
