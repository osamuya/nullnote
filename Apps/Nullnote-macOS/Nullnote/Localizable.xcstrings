    "Finder で表示" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveal in Finder"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder で表示"
          }
        }
      }
    },
    "Finder で表示する" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reveal in Finder"
          }
        },
        "ja" : {
          "stringUnit" : {
