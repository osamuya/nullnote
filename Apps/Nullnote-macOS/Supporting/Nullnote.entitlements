<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store 配布に必須。最初から有効にしておかないと後で必ず詰まる。 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 書類アプリなので、ユーザーが選んだファイルの読み書きだけを許す。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 一度もらったフォルダの許可を、次の起動でも使い回すため。
	     FolderAccess が .withSecurityScope でブックマークを作っている。
	     **これが無いと bookmarkData が nil を返し、毎回聞き直しになる。** -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- 本文に書かれた https:// の画像を読むため。**送信はしない。**
	     文書を開いただけで外部に接続することになるので、増やすときは慎重に。 -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
